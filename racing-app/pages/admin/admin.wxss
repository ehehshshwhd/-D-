.admin-page{min-height:100vh;box-sizing:border-box;padding:34rpx 30rpx 180rpx;background:#f5f6f7;color:#222}.admin-head{display:flex;align-items:center;padding:30rpx;background:linear-gradient(135deg,#ffad18,#f28700);border-radius:20rpx;color:#fff;box-shadow:0 8rpx 24rpx rgba(244,145,0,.24)}.admin-mark{width:76rpx;height:76rpx;line-height:76rpx;text-align:center;border-radius:20rpx;background:rgba(255,255,255,.22);font-size:36rpx;font-weight:700;margin-right:22rpx}.admin-title{font-size:36rpx;font-weight:700}.admin-subtitle{font-size:24rpx;opacity:.86;margin-top:8rpx}.admin-card{display:flex;align-items:center;margin-top:22rpx;padding:28rpx;background:#fff;border-radius:18rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,.05)}.admin-pressed{background:#f0f1f3!important}.admin-icon{width:62rpx;height:62rpx;line-height:62rpx;text-align:center;border-radius:16rpx;background:#fff2d9;color:#f39800;font-size:28rpx;font-weight:700;margin-right:20rpx}.admin-card-body{flex:1;font-size:30rpx}.admin-card-body text{display:block;margin-top:8rpx;color:#999;font-size:23rpx}.admin-arrow{color:#aaa;font-size:42rpx}.admin-state{padding-top:260rpx;text-align:center;color:#888;font-size:29rpx}

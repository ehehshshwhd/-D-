<view class="login-page"><view class="brand-mark">车动泰</view><view class="welcome">登录车动泰</view><view class="hint">手机号仅用于身份验证，赛事内容可直接浏览</view><button class="login-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" loading="{{loading}}" disabled="{{loading}}">{{loading ? '正在登录' : '微信手机号登录'}}</button><view class="login-error">{{error}}</view><button class="cancel-btn" bindtap="cancel">暂不登录</button></view>

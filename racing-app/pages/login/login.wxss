.login-page{min-height:100vh;padding:180rpx 56rpx;text-align:center;box-sizing:border-box}.brand-mark{margin:0 auto 48rpx;width:150rpx;height:150rpx;border-radius:42rpx;background:#f39800;color:#fff;font-size:42rpx;font-weight:700;line-height:150rpx}.welcome{font-size:44rpx;font-weight:600}.hint{margin-top:20rpx;color:#8b8f94;font-size:28rpx}.login-btn{margin-top:100rpx;background:#f39800;color:#fff;border-radius:52rpx;font-size:34rpx;height:100rpx;line-height:100rpx}.login-error{min-height:70rpx;margin-top:24rpx;color:#b93832;font-size:26rpx}.cancel-btn{margin-top:18rpx;background:transparent;color:#888;font-size:28rpx}.cancel-btn::after{border:0}

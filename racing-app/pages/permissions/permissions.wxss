.permission-page{min-height:100vh;box-sizing:border-box;padding:24rpx 0 128rpx;padding-bottom:calc(128rpx + env(safe-area-inset-bottom));background:#f6f6f6;color:rgba(0,0,0,.9)}.permission-hero{position:relative;margin:-24rpx 0 24rpx;padding:40rpx 32rpx 32rpx;background:linear-gradient(145deg,#263038 0%,#34434b 68%,#d87816 180%);color:#fff;border-radius:0 0 24rpx 24rpx;box-shadow:0 4rpx 14rpx rgba(0,0,0,.12)}.hero-kicker,.card-eyebrow{font-size:24rpx;line-height:32rpx;letter-spacing:3rpx;font-weight:700}.hero-kicker{color:#ffbd62}.permission-title{margin-top:12rpx;font-size:48rpx;line-height:64rpx;font-weight:700;letter-spacing:2rpx}.permission-subtitle{width:92%;margin-top:8rpx;color:rgba(255,255,255,.78);font-size:26rpx;line-height:40rpx}.permission-summary{display:flex;align-items:center;margin-top:28rpx}.summary-item{display:flex;flex-direction:column;gap:6rpx;min-width:150rpx}.summary-number{font-size:38rpx;line-height:48rpx;font-weight:700}.summary-label{color:rgba(255,255,255,.7);font-size:24rpx;line-height:32rpx}.summary-divider{width:1rpx;height:48rpx;margin:0 22rpx;background:rgba(255,255,255,.2)}.permission-card{box-sizing:border-box;width:100%;margin-top:20rpx;padding:32rpx;background:#fff;border-top:1rpx solid rgba(0,0,0,.1);border-bottom:1rpx solid rgba(0,0,0,.1);box-shadow:0 2rpx 12rpx rgba(0,0,0,.06)}.card-heading,.account-toolbar,.stage-permission-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}.card-eyebrow{color:#d86d00}.card-title{margin-top:6rpx;font-size:32rpx;line-height:44rpx;font-weight:700}.secure-mark{padding:8rpx 12rpx;border-radius:16rpx;background:#fff3df;color:#c96800;font-size:24rpx;line-height:32rpx;white-space:nowrap}.field-caption{margin-top:24rpx;margin-bottom:10rpx;color:rgba(0,0,0,.6);font-size:26rpx;line-height:36rpx;font-weight:600}.field-caption text{margin-left:8rpx;color:rgba(0,0,0,.4);font-size:24rpx;font-weight:400}.permission-input{box-sizing:border-box;width:100%;height:80rpx;padding:0 20rpx;border:1rpx solid rgba(0,0,0,.1);border-radius:8rpx;background:#fbfcfc;color:rgba(0,0,0,.9);font-size:28rpx;line-height:40rpx}.permission-input:focus,.account-search:focus{border-color:#07c160;background:#fff}.role-caption{margin-top:26rpx}.role-picker{display:flex;gap:16rpx}.role-option{display:flex;align-items:center;gap:12rpx;flex:1;min-height:88rpx;padding:0 14rpx;border:1rpx solid rgba(0,0,0,.1);border-radius:12rpx;color:rgba(0,0,0,.6);font-size:26rpx;line-height:36rpx}.role-option>view>text{display:block;margin-top:4rpx;color:rgba(0,0,0,.4);font-size:24rpx;line-height:32rpx}.role-icon{display:flex;align-items:center;justify-content:center;width:44rpx;height:44rpx;border-radius:12rpx;background:#eef0f2;color:#70777d;font-size:24rpx;font-weight:700}.role-selected{border-color:#e87800;background:#fff5e6;color:#c76700;box-shadow:inset 0 0 0 1rpx #e87800}.role-selected .role-icon{background:#e87800;color:#fff}.stage-permission-box{margin-top:24rpx;padding:24rpx;background:#fff9f0;border:1rpx solid #f0d4a8;border-radius:12rpx}.stage-permission-title{font-size:28rpx;line-height:40rpx;font-weight:700}.stage-permission-subtitle{margin-top:5rpx;color:rgba(0,0,0,.4);font-size:24rpx;line-height:32rpx}.stage-tools{display:flex;gap:18rpx;padding-top:4rpx;color:#d66b00;font-size:24rpx;line-height:32rpx}.stage-choice-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:18rpx}.stage-option{display:flex;align-items:center;justify-content:center;height:68rpx;border:1rpx solid #e1d9ca;border-radius:8rpx;background:#fff;color:rgba(0,0,0,.6);font-size:26rpx;line-height:36rpx}.stage-option checkbox{display:none}.stage-option-checked{border-color:#e87800;background:#e87800;color:#fff;font-weight:700}.admin-access-note{display:flex;align-items:center;gap:10rpx;margin-top:20rpx;padding:18rpx;border-radius:8rpx;background:#f1f8f4;color:#347957;font-size:24rpx;line-height:32rpx}.note-icon{display:flex;align-items:center;justify-content:center;width:32rpx;height:32rpx;border-radius:50%;background:#42a878;color:#fff;font-size:20rpx}.permission-add{box-sizing:border-box;display:flex;align-items:center;justify-content:center;width:100%;height:88rpx;margin:28rpx 0 0;padding:0;border:0!important;border-radius:8rpx!important;background:#f39800!important;color:#fff!important;font-size:28rpx;line-height:40rpx;box-shadow:0 4rpx 12rpx rgba(0,0,0,.12)}.permission-add:after{border:0}.account-total{align-self:flex-end;color:rgba(0,0,0,.4);font-size:24rpx;line-height:32rpx}.account-search{box-sizing:border-box;width:100%;height:72rpx;margin-top:22rpx;padding:0 24rpx;border:1rpx solid rgba(0,0,0,.1);border-radius:16rpx;background:#ededed;color:rgba(0,0,0,.9);font-size:28rpx;line-height:40rpx}.permission-filter{display:flex;margin-top:20rpx;padding:4rpx;border-radius:8rpx;background:#f1f3f4}.filter-option{flex:1;padding:14rpx 0;color:rgba(0,0,0,.4);font-size:26rpx;line-height:36rpx;text-align:center;border-radius:8rpx}.filter-option text{margin-left:5rpx;font-size:24rpx}.filter-active{background:#fff;color:#d66b00;font-weight:700;box-shadow:0 2rpx 8rpx rgba(0,0,0,.08)}.account-list{margin-top:8rpx}.account-item{display:flex;align-items:flex-start;gap:16rpx;min-height:88rpx;padding:24rpx 0;border-bottom:1rpx solid rgba(0,0,0,.1)}.account-item:last-child{border-bottom:0}.account-avatar{display:flex;align-items:center;justify-content:center;flex:none;width:56rpx;height:56rpx;border-radius:16rpx;background:#fff0d7;color:#d66b00;font-size:26rpx;font-weight:700}.admin-avatar{background:#e9edf0;color:#59636b}.account-main{min-width:0;flex:1}.account-phone{font-size:28rpx;line-height:40rpx;font-weight:700;letter-spacing:.3rpx}.account-label{margin-top:5rpx;color:rgba(0,0,0,.4);font-size:24rpx;line-height:32rpx}.stage-chip-row{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:10rpx}.stage-chip{padding:4rpx 10rpx;border-radius:8rpx;background:#fff3df;color:#c96a00;font-size:24rpx;line-height:32rpx}.stage-chip-all{background:#edf0f2;color:#5e6870}.account-actions{display:flex;flex-direction:column;align-items:flex-end;gap:12rpx;flex:none}.account-status,.account-edit,.item-remove{font-size:24rpx;line-height:32rpx}.account-status{display:flex;align-items:center;gap:6rpx}.status-dot{width:10rpx;height:10rpx;border-radius:50%;background:currentColor}.status-on{color:#2f9663}.status-off{color:#9da3a7}.account-edit{color:#d66b00}.item-remove{color:#d83232}.permission-empty{padding:44rpx 0;color:rgba(0,0,0,.4);font-size:26rpx;line-height:36rpx;text-align:center}.permission-state{padding-top:280rpx;color:rgba(0,0,0,.4);font-size:28rpx;line-height:40rpx;text-align:center}
.entry-permission-head{display:flex;align-items:center;justify-content:space-between;margin-top:28rpx;padding-top:24rpx;border-top:1rpx solid #f0d4a8}.entry-permission-subtitle{margin-top:6rpx;color:rgba(0,0,0,.4);font-size:24rpx;line-height:32rpx}.entry-choice-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin-top:16rpx}.entry-option{display:flex;align-items:center;justify-content:center;min-height:68rpx;border:1rpx solid #e1d9ca;border-radius:8rpx;background:#fff;color:rgba(0,0,0,.6);font-size:24rpx;line-height:32rpx}.entry-option checkbox{display:none}.entry-option-checked{border-color:#e87800;background:#e87800;color:#fff;font-weight:700}.entry-chip-row{display:flex;flex-wrap:wrap;gap:6rpx;margin-top:8rpx}.entry-chip{padding:3rpx 8rpx;border-radius:7rpx;background:#edf7f1;color:#2f9663;font-size:22rpx;line-height:28rpx}.entry-chip-all{background:#edf0f2;color:#5e6870}.entry-chip-disabled{background:#f3f3f3;color:#9da3a7}


.account-readonly{color:#8b9095;font-size:22rpx;line-height:32rpx;white-space:nowrap}

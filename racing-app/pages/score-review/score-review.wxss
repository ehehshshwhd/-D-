page{background:#eef1f2;color:#1f2930;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}.review-page{min-height:100vh;background:#eef1f2}.review-shell{display:flex;min-height:100vh}.review-sidebar{display:flex;flex-direction:column;flex:none;width:244rpx;padding:34rpx 20rpx;background:#1f2b30;color:#fff}.brand-mark{display:flex;align-items:center;gap:12rpx;padding:0 8rpx 44rpx}.brand-symbol{display:flex;align-items:center;justify-content:center;width:42rpx;height:42rpx;border-radius:10rpx;background:#e87800;color:#fff;font-size:27rpx;font-weight:800}.brand-name,.brand-sub{display:block}.brand-name{font-size:23rpx;font-weight:800;letter-spacing:1rpx}.brand-sub{margin-top:2rpx;color:#89969b;font-size:19rpx}.side-label{margin:14rpx 8rpx;color:#76858b;font-size:17rpx;letter-spacing:2rpx;font-weight:700}.side-link{display:flex;align-items:center;gap:12rpx;margin:3rpx 0;padding:15rpx 12rpx;border-radius:8rpx;color:#aeb9bc;font-size:22rpx}.side-link-active{background:#35454b;color:#fff}.side-icon{width:22rpx;color:#ee8b2b;font-size:26rpx;text-align:center}.side-spacer{flex:1}.side-footer{margin:0 8rpx;padding-top:20rpx;border-top:1rpx solid #344248}.side-role,.side-user{display:block;margin-top:8rpx}.side-role{font-size:22rpx}.side-user{color:#89969b;font-size:19rpx}.review-main{flex:1;min-width:0;padding:34rpx 38rpx 42rpx}.topbar{display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx}.hero-kicker,.section-kicker{font-size:18rpx;line-height:26rpx;letter-spacing:2rpx;font-weight:800}.hero-kicker{display:block;color:#bd6b22}.hero-title{display:block;margin-top:6rpx;font-size:42rpx;line-height:56rpx;font-weight:800}.topbar-actions{display:flex;gap:10rpx}.top-action,.top-publish{height:56rpx;margin:0;padding:0 20rpx;border-radius:7rpx;font-size:21rpx;line-height:56rpx}.top-action{border:1rpx solid #d5dcde;background:#fff;color:#45535a}.top-publish{border:0;background:#e87800;color:#fff;font-weight:700}.top-action:after,.top-publish:after{border:0}.event-picker-wrap{margin-top:28rpx}.event-picker{display:flex;align-items:center;justify-content:space-between;padding:20rpx 22rpx;border:1rpx solid #dbe1e3;border-radius:9rpx;background:#fff}.event-picker-copy{min-width:0}.event-picker-label{display:block;color:#879298;font-size:19rpx;line-height:26rpx}.event-picker-name{display:block;margin-top:5rpx;overflow:hidden;color:#233039;font-size:25rpx;line-height:34rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.event-picker-meta{display:block;margin-top:4rpx;color:#8e999e;font-size:19rpx;line-height:26rpx}.picker-arrow{margin-left:14rpx;color:#d56b00;font-size:34rpx}.summary-bar{display:flex;align-items:center;margin-top:18rpx;padding:18rpx 24rpx;border:1rpx solid #dfe4e5;background:#fff;border-radius:9rpx}.summary-item{min-width:110rpx;text-align:left}.summary-value{display:block;color:#26353b;font-size:32rpx;line-height:42rpx;font-weight:800}.summary-label{display:block;color:#879298;font-size:18rpx;line-height:26rpx}.summary-pending .summary-value{color:#c97813}.summary-passed .summary-value{color:#16845a}.summary-note{margin-left:auto;color:#95a0a4;font-size:18rpx;text-align:right}.summary-note strong{display:block;margin-top:3rpx;color:#354249;font-size:21rpx}.stage-section,.records-section{margin-top:30rpx}.section-head,.records-head{display:flex;align-items:flex-end;justify-content:space-between;padding:0 0 12rpx}.section-kicker{display:block;color:#b06a34}.section-title{display:block;margin-top:4rpx;font-size:29rpx;line-height:40rpx;font-weight:800}.section-hint{color:#99a3a7;font-size:18rpx}.stage-scroll,.filter-scroll{width:100%;white-space:nowrap}.stage-track,.filter-track{display:inline-flex;padding:2rpx 0 8rpx}.stage-chip{display:flex;align-items:center;justify-content:center;height:52rpx;min-width:84rpx;margin-right:8rpx;padding:0 17rpx;border:1rpx solid #d3dcde;border-radius:6rpx;background:#fff;color:#67757a;font-size:21rpx}.stage-chip-active{border-color:#e87

.avatar-wrap{width:120rpx;height:120rpx;flex:none}.avatar-image,.avatar-placeholder{width:120rpx;height:120rpx;border-radius:60rpx}.avatar-placeholder{background:#eee;text-align:center;line-height:120rpx;font-size:54rpx;color:#aaa}
.login-empty{height:calc(100vh - 180rpx);display:flex;flex-direction:column;align-items:center;justify-content:center;color:#202020}.empty-symbol{font-size:170rpx;line-height:180rpx;font-weight:200;color:#222;transform:rotate(45deg)}.empty-text{margin-top:22rpx;font-size:32rpx;color:#333}
/* 与 custom-tab-bar/index.wxss 对齐：140rpx 导航 + 1px 边框 + 底部安全区。
   弹窗在导航上方结束，避免依赖真机不同渲染层之间的 z-index。 */
.login-mask{
  position:fixed;
  z-index:200;
  top:0;
  right:0;
  bottom:calc(140rpx + 1px);
  bottom:calc(140rpx + 1px + env(safe-area-inset-bottom));
  left:0;
  background:rgba(0,0,0,.7);
}
.login-sheet{
  position:absolute;
  left:0;
  right:0;
  bottom:0;
  z-index:201;
  max-height:100%;
  overflow-y:auto;
  padding:0 48rpx 26rpx;
  background:#fff;
  border-radius:32rpx 32rpx 0 0;
  box-sizing:border-box;
  text-align:center;
}
.sheet-title{height:100rpx;line-height:100rpx;font-size:32rpx;color:#222}
.sheet-close{position:absolute;right:16rpx;top:18rpx;width:64rpx;height:64rpx;line-height:58rpx;font-size:44rpx;font-weight:200;color:#111}
.sheet-divider{height:1px;background:#f0f0f0;margin:0 -48rpx}
.privacy-link{margin:48rpx 0;color:#66778f;font-size:30rpx}
.login-sheet .phone-login{
  display:block;
  width:100%;
  margin:0;
  padding:0 12rpx;
  box-sizing:border-box;
  height:92rpx;
  line-height:92rpx;
  border-radius:48rpx;
  background:#ff9d00;
  color:#fff;
  font-size:28rpx;
}
.phone-login::after{border:0}
.sheet-error{min-height:42rpx;line-height:1.5;margin-top:16rpx;color:#c33;font-size:24rpx;word-break:break-all}
.admin-entry{height:108rpx;margin:22rpx 42rpx 0;padding:0 24rpx;display:flex;align-items:center;background:#fff;border-radius:14rpx;color:#222;font-size:32rpx;box-sizing:border-box}.admin-badge{width:48rpx;height:48rpx;line-height:48rpx;text-align:center;margin-right:18rpx;border-radius:12rpx;background:#fff0d1;color:#f39800;font-size:25rpx;font-weight:700}
/* 统一“我的”页面的文字、图标和箭头基线 */
.profile-head{min-height:196rpx}
.profile-info{display:flex;flex-direction:column;justify-content:center;min-width:0}
.username,.role{line-height:1.3}
.edit{display:flex;align-items:center;white-space:nowrap;line-height:1}
.admin-entry{padding-left:24rpx;padding-right:0}
.admin-entry .arrow,.menu-row .arrow{display:flex;align-items:center;height:54rpx;line-height:1}
.menu-row{line-height:1}
.menu-row .mi{display:flex;align-items:center;height:54rpx;line-height:1}

/* 个人中心菜单连续铺满，管理入口、订单和其他菜单之间不再出现灰色缝隙。 */
.profile-menu-list{margin-top:0;background:#fff}
.profile-menu-list .admin-entry{height:108rpx;margin:0;padding:0 42rpx;border-radius:0}
.profile-menu-list .menu-group{margin:0;padding:0 42rpx;background:#fff}
.profile-menu-list .menu-row{box-sizing:border-box}

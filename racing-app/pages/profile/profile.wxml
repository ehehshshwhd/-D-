<view class="profile-page">
  <view wx:if="{{!loggedIn}}" class="login-empty" bindtap="onProfileTap"><view class="empty-symbol">×</view><view class="empty-text">请先登录账户</view></view>
  <view wx:if="{{loggedIn}}">
    <view class="profile-head" hover-class="row-pressed" hover-stay-time="80" bindtap="onProfileTap"><view class="avatar-wrap"><image wx:if="{{user.avatarUrl}}" class="avatar-image" src="{{user.avatarUrl}}" mode="aspectFill" /><view wx:else class="avatar-placeholder">👤</view></view><view class="profile-info"><view class="username">{{user.nickname}}</view><view class="role">{{user.isSuperAdmin ? '最高管理员' : (user.isAdmin ? '管理员' : (user.isStaff ? '工作人员' : '个人用户'))}}</view></view><view class="edit">修改　›</view></view>
    <view class="profile-menu-list">
      <view wx:if="{{user.isAdmin}}" class="admin-entry" hover-class="row-pressed" bindtap="openAdmin"><text class="admin-badge">管</text><text>管理后台</text><text class="arrow">›</text></view>
      <view class="menu-group"><view class="menu-row" hover-class="row-pressed" hover-stay-time="80" data-label="我的订单" bindtap="openMenu"><text class="mi orange">▣</text><text>我的订单</text><text class="arrow">›</text></view></view>
      <view class="menu-group"><view wx:for="{{['我的钱包','我的动态','实名认证','收货地址','设置']}}" wx:key="*this" class="menu-row" hover-class="row-pressed" hover-stay-time="80" data-label="{{item}}" bindtap="openMenu"><text class="mi">●</text><text>{{item}}</text><text class="arrow">›</text></view></view>
    </view>
    <button class="logout" bindtap="logout">退出登录</button>
  </view>
  <view wx:if="{{showLoginSheet}}" class="login-mask" catchtap="closeLoginSheet"><view class="login-sheet" catchtap="noop"><view class="sheet-title">授权登录</view><view class="sheet-close" bindtap="closeLoginSheet">×</view><view class="sheet-divider"></view><view class="privacy-link" bindtap="openPrivacy">《查看隐私协议》</view><button class="phone-login" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber" loading="{{loading}}" disabled="{{loading}}">{{loading ? '正在授权' : '同意协议并授权登录'}}</button><view class="sheet-error">{{error}}</view></view></view>
</view>

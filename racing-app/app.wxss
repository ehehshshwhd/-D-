page{background:#f5f6f7;color:#252525;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}.content{padding:30rpx 24rpx 180rpx}.empty{padding:160rpx 24rpx;text-align:center;color:#888;font-size:28rpx}.profile-page{padding-bottom:180rpx}.profile-head{display:flex;align-items:center;width:100%;padding:44rpx 42rpx;background:#fff;box-sizing:border-box}.avatar{width:120rpx;height:120rpx;border-radius:60rpx;background:#eee;text-align:center;line-height:120rpx;font-size:54rpx}.profile-info{margin-left:30rpx;flex:1}.username{font-size:36rpx}.role{font-size:28rpx;color:#888;margin-top:14rpx}.edit{color:#888}.menu-group{margin-top:22rpx;background:#fff;padding:0 42rpx}.menu-row{height:108rpx;display:flex;align-items:center;border-bottom:1px solid #eee;font-size:32rpx}.mi{width:54rpx;color:#888}.orange{color:#f39800}.arrow{margin-left:auto;color:#999;font-size:44rpx}.logout{margin:40rpx 42rpx;background:#fff;color:#d44;border:1px solid #eee}.logout::after{border:0}
